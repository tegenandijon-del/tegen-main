{
  "name": "@tegen/server",
  "private": true,
  "version": "0.2.0",
  "type": "commonjs",
  "scripts": {
    "build": "prisma generate --schema=./schema.prisma && tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "start:dev": "tsx src/main.ts",
    "prisma:generate": "prisma generate --schema=./schema.prisma",
    "prisma:push": "prisma db push --schema=./schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=./schema.prisma",
    "db:seed": "tsx seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "prisma": "5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
